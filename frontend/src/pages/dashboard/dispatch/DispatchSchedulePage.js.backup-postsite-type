// Convert a matrix of values into a CSV string (RFC 4180-compatible quoting).
const buildCsv = (headers, rows) => {
  const esc = (v) => {
    const s = v == null ? '' : String(v);
    return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  return [headers.map(esc).join(','), ...rows.map((row) => row.map(esc).join(','))].join('\r\n');
};

// Build a styled .xlsx workbook that mirrors the on-screen schedule table
// (pink header band, tinted "Date" column, red bold post pin cells, green
// city cells, black-bold date cells). We do this client-side because visible
// columns are chosen per-user and we want to export exactly what the user
// sees on-screen.
async function buildScheduleXlsx({ headers, rows, columnKeys, filename }) {
  const ExcelJS = (await import('exceljs')).default;
  const wb = new ExcelJS.Workbook();
  wb.creator = 'OfficeFlow';
  const ws = wb.addWorksheet('Dispatch Schedule', {
    views: [{ state: 'frozen', ySplit: 1 }],
  });

  ws.addRow(headers);
  const headerRow = ws.getRow(1);
  headerRow.height = 26;
  headerRow.eachCell((cell) => {
    cell.font = { bold: true, color: { argb: 'FF0F172A' }, size: 11 };
    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFBC9FF' } };
    cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
    cell.border = {
      top: { style: 'thin', color: { argb: 'FFE2E8F0' } },
      left: { style: 'thin', color: { argb: 'FFE2E8F0' } },
      right: { style: 'thin', color: { argb: 'FFE2E8F0' } },
      bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } },
    };
  });

  rows.forEach((row) => {
    const r = ws.addRow(row);
    r.eachCell((cell, colNumber) => {
      const key = columnKeys[colNumber - 1];
      cell.alignment = { vertical: 'middle', wrapText: false };
      cell.font = { size: 11, color: { argb: 'FF334155' } };
      cell.border = {
        top: { style: 'thin', color: { argb: 'FFE2E8F0' } },
        left: { style: 'thin', color: { argb: 'FFE2E8F0' } },
        right: { style: 'thin', color: { argb: 'FFE2E8F0' } },
        bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } },
      };
      if (key === 'date') {
        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFBC9FF' } };
        cell.font = { bold: true, size: 11, color: { argb: 'FF000000' } };
      } else if (key === 'officer') {
        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE8FAFF' } };
      } else if (key === 'post_pin') {
        cell.font = { bold: true, size: 11, color: { argb: 'FFDC2626' } };
      } else if (key === 'city') {
        cell.font = { bold: true, size: 11, color: { argb: 'FF059669' } };
      } else if (key === 'duty_rate' || key === 'billing_rate' || key === 'duty_hours') {
        cell.alignment = { horizontal: 'right', vertical: 'middle' };
      }
    });
  });

  const widthByKey = {
    date: 20, shift: 14, start_time: 12, end_time: 12, duty_hours: 12,
    duty_rate: 14, billing_rate: 16, site: 28, city: 16, post_pin: 16,
    officer: 24, shift_status: 20, confirmation: 22, confirmed_by: 26,
    remarks: 32, client: 24, vendor: 24,
  };
  columnKeys.forEach((k, i) => { ws.getColumn(i + 1).width = widthByKey[k] || 16; });

  const buf = await wb.xlsx.writeBuffer();
  const blob = new Blob([buf], {
    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

const downloadFile = (filename, mime, content) => {
  const blob = new Blob(['\uFEFF' + content], { type: mime + ';charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 500);
};

const DispatchSchedulePage = ({ todayOnly = false }) => {
