            </DialogDescription>
          </DialogHeader>

          <div className="space-y-4">
            <div className="rounded-lg border border-[#E2E8F0] dark:border-[#27272A] p-3 text-xs text-[#334155] dark:text-[#E4E4E7] space-y-2">
              <div className="font-semibold text-[#0F172A] dark:text-[#FAFAFA]">Required columns</div>
              <div className="font-mono text-[11px] bg-[#F8FAFC] dark:bg-[#0F0F11] p-2 rounded">
                date, shift_type, start_time, end_time, officer_name, post_pin
              </div>
              <div className="font-semibold text-[#0F172A] dark:text-[#FAFAFA]">Optional columns</div>
              <div className="font-mono text-[11px] bg-[#F8FAFC] dark:bg-[#0F0F11] p-2 rounded">
                work_order_number, officer_email, client_name, vendor_name, duty_rate, billing_rate, remarks
