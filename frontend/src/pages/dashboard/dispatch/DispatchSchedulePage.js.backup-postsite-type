    todayOnly ? { ...emptyFilters, date_from: new Date().toISOString().slice(0, 10), date_to: new Date().toISOString().slice(0, 10) } : emptyFilters
  );

  const [clients, setClients] = useState([]);
  const [vendors, setVendors] = useState([]);
  const [officers, setOfficers] = useState([]);
  const [postSites, setPostSites] = useState([]);
  const [siteDialogOpen, setSiteDialogOpen] = useState(false);
  const emptySiteForm = { post_pin: '', name: '', location: '', city: '', notes: '' };
  const [siteForm, setSiteForm] = useState(emptySiteForm);

  const [dialogOpen, setDialogOpen] = useState(false);
  const [editing, setEditing] = useState(null);
  const [form, setForm] = useState({});
  const [scheduleMode, setScheduleMode] = useState('once');

  const [confDialog, setConfDialog] = useState(null);
  const [confForm, setConfForm] = useState({ confirmation_status: 'Confirmed', confirmation_method: 'Call', remarks: '' });
  const [actionsDialog, setActionsDialog] = useState(null);
  const [actions, setActions] = useState([]);
  const [actionsLoading, setActionsLoading] = useState(false);
  const [statusBusy, setStatusBusy] = useState(null);
  const [statusDialog, setStatusDialog] = useState(null); // { row, status }
  const [statusRemarks, setStatusRemarks] = useState('');
  const [remarkEditId, setRemarkEditId] = useState(null);
  const [remarkDraft, setRemarkDraft] = useState('');
  const [remarkSaving, setRemarkSaving] = useState(false);
  const [remarkLineEdit, setRemarkLineEdit] = useState(null); // { rowId, idx }
  const [remarkLineDraft, setRemarkLineDraft] = useState('');
  const [filtersOpen, setFiltersOpen] = useState(false);

  const getRemarksList = (r) => {
    // Combine remarks from every source: creation + inline edits (stored in
    // `remarks`) and the latest status/confirmation remark (`last_modified_remarks`).
    const fromRemarks = String(r.remarks || '').split('\n').map((s) => s.trim()).filter(Boolean);
    const fromStatus = String(r.last_modified_remarks || '').split('\n').map((s) => s.trim()).filter(Boolean);
    const seen = new Set(fromRemarks);
    const merged = [...fromRemarks];
    for (const s of fromStatus) {
      if (!seen.has(s)) { seen.add(s); merged.push(s); }
    }
    return merged;
  };

  const persistRemarks = async (r, combined) => {
    await api.put(`/dispatch/schedules/${r.id}`, { remarks: combined || null });
    setRows((prev) => prev.map((x) => (x.id === r.id ? { ...x, remarks: combined, last_modified_remarks: combined } : x)));
  };

  const addRemark = async (r) => {
    const text = remarkDraft.trim();
    if (!text) { setRemarkEditId(null); setRemarkDraft(''); return; }
    const lines = getRemarksList(r);
    const combined = [...lines, text].join('\n');
    setRemarkSaving(true);
    try {
      await persistRemarks(r, combined);
      setRemarkDraft('');
      setRemarkEditId(null);
      toast.success('Remark added');
    } catch (e) {
      toast.error(formatApiErrorDetail(e.response?.data?.detail) || 'Failed to add remark');
    } finally { setRemarkSaving(false); }
  };

  const removeRemarkLine = async (r, idx) => {
    const next = getRemarksList(r).filter((_, i) => i !== idx).join('\n');
    try {
      await persistRemarks(r, next);
    } catch (e) {
      toast.error(formatApiErrorDetail(e.response?.data?.detail) || 'Failed to remove remark');
    }
  };

  const saveRemarkLine = async (r, idx) => {
    const text = remarkLineDraft.trim();
    const lines = getRemarksList(r);
    const next = (text
      ? lines.map((l, i) => (i === idx ? text : l))
      : lines.filter((_, i) => i !== idx)
    ).join('\n');
    setRemarkSaving(true);
    try {
      await persistRemarks(r, next);
      setRemarkLineEdit(null);
      setRemarkLineDraft('');
      toast.success(text ? 'Remark updated' : 'Remark removed');
    } catch (e) {
      toast.error(formatApiErrorDetail(e.response?.data?.detail) || 'Failed to update remark');
    } finally { setRemarkSaving(false); }
  };


  // ---- Bulk CSV import state -------------------------------------------
  const [importOpen, setImportOpen] = useState(false);
  const [importFile, setImportFile] = useState(null);
  const [importBusy, setImportBusy] = useState(false);
  const [importResult, setImportResult] = useState(null);

  // ---- Column chooser: per-user visibility + order, persisted in localStorage ----
  const availableCols = COLUMN_CATALOG.filter((c) => canFinancial || !c.financial);
  const storageKey = `dispatch.schedule.columns.${user?.id || 'anon'}`;
  const defaultConfig = availableCols.map((c) => ({ key: c.key, visible: true }));

  const [columnConfig, setColumnConfig] = useState(() => {
    try {
      const raw = localStorage.getItem(storageKey);
      if (raw) {
        const parsed = JSON.parse(raw);
        const known = new Set(availableCols.map((c) => c.key));
        // keep only known keys in stored order, then append any new keys
        const cleaned = parsed.filter((c) => known.has(c.key));
        availableCols.forEach((c) => {
          if (!cleaned.find((x) => x.key === c.key)) cleaned.push({ key: c.key, visible: true });
        });
        return cleaned;
      }
    } catch (e) {
      // Corrupt/legacy JSON — log and fall through to defaults.
      console.warn('DispatchSchedulePage: could not read column config from localStorage', e);
    }
    return defaultConfig;
  });

  useEffect(() => {
    try {
      localStorage.setItem(storageKey, JSON.stringify(columnConfig));
    } catch (e) {
      // Quota errors etc. — non-fatal but worth logging.
      console.warn('DispatchSchedulePage: could not persist column config', e);
    }
  }, [columnConfig, storageKey]);

  const [chooserOpen, setChooserOpen] = useState(false);
  const [dragKey, setDragKey] = useState(null);

  // ---- Column widths (resizable by dragging the header edge) --------------
  const widthsKey = `dispatch.schedule.colWidths.${user?.id || 'anon'}`;
  const [colWidths, setColWidths] = useState(() => {
    try {
      const raw = localStorage.getItem(widthsKey);
      if (raw) return JSON.parse(raw);
    } catch (e) {
      console.warn('DispatchSchedulePage: could not read column widths', e);
    }
    return {};
  });
  useEffect(() => {
    try {
      localStorage.setItem(widthsKey, JSON.stringify(colWidths));
    } catch (e) {
      console.warn('DispatchSchedulePage: could not persist column widths', e);
    }
  }, [colWidths, widthsKey]);

  // ---- Row density (compact / comfortable) — persisted per user ----------
  const densityKey = `dispatch.schedule.density.${user?.id || 'anon'}`;
  const [density, setDensity] = useState(() => {
    try {
      const v = localStorage.getItem(densityKey);
      if (v === 'compact' || v === 'comfortable') return v;
    } catch (e) {
      console.warn('DispatchSchedulePage: could not read density preference', e);
    }
    return 'comfortable';
  });
  useEffect(() => {
    try {
      localStorage.setItem(densityKey, density);
    } catch (e) {
      console.warn('DispatchSchedulePage: could not persist density preference', e);
    }
  }, [density, densityKey]);
  const isCompact = density === 'compact';
  const thPad = isCompact ? 'px-2.5 py-1.5' : 'px-3 py-2.5';
  const tdPad = isCompact ? 'px-2.5 py-1.5' : 'px-3 py-2';
  const tableTextSize = isCompact ? 'text-xs' : 'text-sm';

  const startResize = (key, e) => {
    e.preventDefault();
    e.stopPropagation();
    const startX = e.clientX;
    const th = e.currentTarget.closest('th');
    const startW = th ? th.getBoundingClientRect().width : 140;
    const onMove = (ev) => {
      const w = Math.max(60, Math.min(800, startW + (ev.clientX - startX)));
      setColWidths((prev) => ({ ...prev, [key]: w }));
    };
    const onUp = () => {
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
    };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
  };

  const visibleCols = columnConfig
    .filter((c) => c.visible)
    .map((c) => availableCols.find((x) => x.key === c.key))
    .filter(Boolean);
  const getColWidth = (key) => colWidths[key] || DEFAULT_COLUMN_WIDTHS[key] || 140;
  const tableMinWidth = visibleCols.reduce((sum, c) => sum + getColWidth(c.key), MANAGE_COLUMN_WIDTH);

  const toggleColumn = (key) =>
    setColumnConfig((prev) => prev.map((c) => (c.key === key ? { ...c, visible: !c.visible } : c)));
  const moveColumn = (fromKey, toKey) => {
    if (!fromKey || !toKey || fromKey === toKey) return;
    setColumnConfig((prev) => {
      const arr = prev.slice();
      const fromIdx = arr.findIndex((c) => c.key === fromKey);
      const toIdx = arr.findIndex((c) => c.key === toKey);
      if (fromIdx < 0 || toIdx < 0) return prev;
      const [moved] = arr.splice(fromIdx, 1);
      arr.splice(toIdx, 0, moved);
      return arr;
    });
  };
  const resetColumns = () => { setColumnConfig(defaultConfig); setColWidths({}); setDensity('comfortable'); };

  const exportExcel = async () => {
    const headers = visibleCols.map((c) => c.label);
    const body = rows.map((r) => visibleCols.map((c) => c.csv(r)));
    const columnKeys = visibleCols.map((c) => c.key);
    const stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
    try {
      await buildScheduleXlsx({
        headers, rows: body, columnKeys,
        filename: `dispatch-schedule-${stamp}.xlsx`,
