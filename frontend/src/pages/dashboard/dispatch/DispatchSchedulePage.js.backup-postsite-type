                  </span>
                  <span className="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">
                    Errors: <b data-testid="import-errors-count">{importResult.errors?.length ?? 0}</b>
                  </span>
                </div>

                {importResult.skipped && importResult.skipped.length > 0 && (
                  <div className="border border-[#E2E8F0] dark:border-[#27272A] rounded-lg overflow-hidden max-h-40 overflow-y-auto">
                    <table className="w-full text-xs" data-testid="import-skipped-table">
                      <thead className="bg-[#F8FAFC] dark:bg-[#0F0F11] text-[#64748B]">
                        <tr>
                          <th className="px-3 py-2 text-left w-16">Row</th>
