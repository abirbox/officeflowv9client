              {importBusy ? 'Importing…' : 'Import CSV'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>


      {/* Confirmation dialog */}
      <Dialog open={!!confDialog} onOpenChange={(o) => !o && setConfDialog(null)}>
        <DialogContent>
