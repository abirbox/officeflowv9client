# ---------- Security Officer ----------
OFFICER_STATUSES = ["active", "inactive", "suspended", "terminated", "on_leave"]

OFFICER_TYPES = ["Armed", "Unarmed"]

class OfficerBase(BaseModel):
    # Automatically generated from the selected Client's code.
    # Kept in the model for backward compatibility, but the backend
    # controls the actual stored value.
    officer_code: Optional[str] = None
    profile_image: Optional[str] = None
    name: str
    contact_number: str  # required
    alternate_contact_number: Optional[str] = None
    address: Optional[str] = None
    email: Optional[EmailStr] = None
    client_id: str  # Security Officer must belong to a Client
    type: str = "Unarmed"
    status: str = "active"
    joining_date: Optional[str] = None
    notes: Optional[str] = None

class OfficerCreate(OfficerBase):
    pass

class OfficerUpdate(BaseModel):
    # Accepted for backward compatibility, but backend always regenerates
    # officer_code from the selected Client.
    officer_code: Optional[str] = None
    profile_image: Optional[str] = None
    name: Optional[str] = None
    contact_number: Optional[str] = None
    alternate_contact_number: Optional[str] = None
    address: Optional[str] = None
    email: Optional[EmailStr] = None
    client_id: Optional[str] = None
    type: Optional[str] = None
    status: Optional[str] = None
    joining_date: Optional[str] = None
    notes: Optional[str] = None

# ---------- Post Site ----------
class PostSiteBase(BaseModel):
    post_pin: str
